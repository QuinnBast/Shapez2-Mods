# Build output
bin/
obj/

# Publicizer log
logs/

# Steam publish scratch. SteamPublish.sh fills the absolute paths into a copy of base.vdf
# and deletes it afterwards, so this only catches an interrupted run. Unanchored on purpose:
# the Steam folder sits beside the csproj, not beside this file.
base.tmp.vdf

# IDE
.idea/
.vs/
*.user

# steamcmd transcript from Steam/SteamPublish.sh
publish.log

# Raw screen captures. These are the *input* to tools/caption-screenshots.py, 16 files and
# 42 MB of them, and only the captioned output is ever published - so the output is tracked
# and the sources are not. Re-running the caption script therefore needs the original
# captures, which live on the machine that took them; a fresh clone can change a caption's
# wording in the script but cannot regenerate the images without them.
#
# Matches only the top level: captioned/ is a directory below this and a single * does not
# cross one, so the published files there stay tracked.
FirstPerson/Screenshots/*.png
