# Decompiled game assemblies. Never commit these: they are tobspr's shipped code,
# reconstructed for reference only, and cannot be redistributed. Regenerate locally
# instead — see the README.
decompiled/

# tobspr's official sample repository. Cloned in place, keeping its own git so it still
# tracks upstream — ignored here rather than vendored into this history.
shapez2-mod-samples/

# .NET build output
bin/
obj/
*.user

# Publicizer report, written per build by Krafs.Publicizer
**/logs/krafs.log

# Rider / Visual Studio
.idea/
.vs/
*.suo
*.userprefs

# macOS
.DS_Store

# Python bytecode, from the offline art generators in */Tools
__pycache__/
*.pyc

# SteamPublish.sh writes a transcript beside base.vdf, because the console it runs in is often
# a window that closes the moment the script ends. Local diagnostics, not source.
publish.log
.steamcmd.out
